# Clé OpenAI pour l'extraction IA des factures scannées (recommandé)
OPENAI_API_KEY=sk-...

# Modèle vision principal (défaut: gpt-5.4-mini)
# Bon rapport coût/fiabilité pour l'extraction structurée de factures.
# OPENAI_VISION_MODEL=gpt-5.4-mini

# Modèle de secours pour les scans difficiles (défaut: gpt-5.6-terra)
# Utilisé automatiquement quand les montants extraits sont incohérents.
# Lit la page en pleine résolution (tableaux TVA denses, photos floues).
# OPENAI_VISION_MODEL_FALLBACK=gpt-5.6-terra
