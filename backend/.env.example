# Clé OpenAI pour l'extraction IA des factures scannées (recommandé)
OPENAI_API_KEY=sk-...
# Supabase (projet Recompta) — ne jamais mettre service_role dans le frontend
# SUPABASE_URL=https://pbyoxfxngfutoiqjirkx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=  # backend / edge function uniquement — jamais dans le frontend

# Modèle vision principal (défaut: gpt-5.4-mini)
# Bon rapport coût/fiabilité pour l'extraction structurée de factures.
# OPENAI_VISION_MODEL=gpt-5.4-mini

# IMPORT_WORKER_ENABLED=1
# IMPORT_WORKER_POLL_SECONDS=8

# Augmentez si votre quota OpenAI le permet, baissez en cas d'erreurs 429.
# Factures lues en même temps, sur tout le serveur (défaut 2, max 12).
# Codespace : 2. Serveur avec plus de mémoire : 4. Voir "memory_peak_mb" dans /api/health.
# EXTRACTION_CONCURRENCY=2

# Modèle de secours pour les scans difficiles (défaut: gpt-5.6-terra)
# Utilisé automatiquement quand les montants extraits sont incohérents.
# Lit la page en pleine résolution (tableaux TVA denses, photos floues).
# OPENAI_VISION_MODEL_FALLBACK=gpt-5.6-terra

# CORS : origines autorisées à appeler l'API depuis un navigateur.
# Par défaut : https://anaslaghezali-ops.github.io, http://localhost:<port>,
# http://127.0.0.1:<port> et les Codespaces https://*.app.github.dev.
# Le site servi par ce serveur lui-même (même adresse) n'a pas besoin de CORS.
# Ajouter d'autres origines (ex. futur VPS), séparées par des virgules :
# CORS_ALLOWED_ORIGINS=https://app.exemple.ma,https://www.exemple.ma
# Secours : autoriser toutes les origines (ancien comportement) :
# CORS_ALLOWED_ORIGINS=*
